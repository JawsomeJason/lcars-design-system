# Generated by scripts/build.mjs from tokens/. Do not edit; run `node scripts/build.mjs`.
# Selects the palette named by LCARS_PALETTE (default tng). LCARS maps every color and role name
# to its hex; lcars_rgb NAME sets lcars_rgb_out to its R;G;B, the contract pill.sh reads.
typeset -g lcars_dim_percent=40 lcars_dim_step=51 lcars_blink_seconds=1
typeset -gA LCARS
case ${LCARS_PALETTE:-tng} in
  2375)
    typeset -g lcars_palette=2375
    LCARS=(
      danub '#6688cc'
      indigo '#4455bb'
      lavender-purple '#9977aa'
      cosmic '#774466'
      red-damask '#dd6644'
      medium-carmine '#aa5533'
      bourbon '#bb6622'
      sandy-brown '#ee9955'
      unlit '#333333'
      black '#000000'
      text '#ee9955'
      label-ink '#000000'
      emphasis-ink '#ee9955'
      value '#ee9955'
      muted '#9977aa'
      alert '#dd6644'
      warning '#bb6622'
      ok '#6688cc'
      accent '#bb6622'
      accent-2 '#9977aa'
      accent-3 '#4455bb'
      accent-4 '#6688cc'
      accent-5 '#774466'
      added '#ee9955'
      removed '#dd6644'
    ) ;;
  *)
    typeset -g lcars_palette=tng
    LCARS=(
      atomic-tangerine '#ff9900'
      golden-tanoi '#ffcc66'
      tanoi '#ffcc99'
      pale-canary '#ffff99'
      lilac '#cc99cc'
      hopbush '#cc6699'
      melrose '#9999ff'
      blue-bell '#9999cc'
      anakiwa '#99ccff'
      mariner '#3366cc'
      chestnut-rose '#cc6666'
      eggplant '#664466'
      unlit '#333333'
      black '#000000'
      text '#ffcc99'
      label-ink '#000000'
      emphasis-ink '#ffff99'
      value '#ffcc66'
      muted '#9999cc'
      alert '#cc6666'
      warning '#ff9900'
      ok '#99ccff'
      accent '#ff9900'
      accent-2 '#cc99cc'
      accent-3 '#9999ff'
      accent-4 '#99ccff'
      accent-5 '#cc6699'
      added '#ffcc99'
      removed '#cc6666'
    ) ;;
esac
lcars_rgb() {
  local h=${LCARS[$1]#\#}
  [[ -n $h ]] || return 1
  lcars_rgb_out="$((16#${h[1,2]}));$((16#${h[3,4]}));$((16#${h[5,6]}))"
}
