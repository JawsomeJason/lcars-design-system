{
  "$description": "Nemesis, Enterprise-E blue. Measured from Nemesis 2023 Blu-ray frames (TrekCore) and Memory Alpha captures; blue grade cast removed, snapped; screen-true values, alert included.",
  "$extensions": {
    "lcars.theme": {
      "name": "NEM",
      "era": "Nemesis, Enterprise-E blue"
    }
  },
  "role": {
    "$type": "color",
    "bg": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0,
          0.0,
          0.0
        ],
        "hex": "#000000"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0,
          0.0,
          0.0
        ],
        "hex": "#000000"
      }
    },
    "frame": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0667,
          0.4667,
          0.7333
        ],
        "hex": "#1177bb"
      }
    },
    "block": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.2,
          0.6,
          0.8
        ],
        "hex": "#3399cc"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.2667,
          0.8,
          0.9333
        ],
        "hex": "#44ccee"
      }
    },
    "stub": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.8,
          0.6,
          0.4
        ],
        "hex": "#cc9966"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.8667,
          0.8,
          0.6667
        ],
        "hex": "#ddccaa"
      }
    },
    "meter-on": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          0.6
        ],
        "hex": "#ffff99"
      }
    },
    "meter-off": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.4667,
          0.6,
          0.6667
        ],
        "hex": "#7799aa"
      }
    },
    "alert": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.749,
          0.0,
          0.0
        ],
        "hex": "#bf0000"
      }
    },
    "focus": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.8,
          0.4,
          0.0
        ],
        "hex": "#cc6600"
      }
    },
    "data": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.2667,
          0.8,
          0.9333
        ],
        "hex": "#44ccee"
      }
    },
    "data-hi": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "hex": "#ffffff"
      }
    }
  },
  "mode": {
    "light": {
      "$description": "Light-scheme values measured for this theme in the LCARS lab.",
      "role": {
        "$type": "color",
        "bg": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.9333,
              0.9333,
              0.9333
            ],
            "hex": "#eeeeee"
          }
        },
        "text": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.1333,
              0.1333,
              0.1333
            ],
            "hex": "#222222"
          }
        },
        "focus": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.7333,
              0.3333,
              0.0
            ],
            "hex": "#bb5500"
          }
        },
        "data": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.1333,
              0.3333,
              0.4
            ],
            "hex": "#225566"
          }
        },
        "display": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.0,
              0.2,
              0.3333
            ],
            "hex": "#003355"
          }
        },
        "alert-text": {
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.4667,
              0.0667,
              0.0
            ],
            "hex": "#771100"
          }
        }
      }
    }
  }
}
