{
  "name": "lcars-design-system",
  "version": "0.6.0",
  "description": "LCARS-inspired design system: design tokens, component specs and a docs site. dist/tokens.json is the resolved form for consumers.",
  "main": "./dist/tokens.json",
  "exports": {
    ".": "./dist/tokens.json",
    "./tokens.json": "./dist/tokens.json",
    "./tokens/*": "./tokens/*",
    "./spec/*": "./spec/*",
    "./package.json": "./package.json",
    "./docs/*": "./docs/*"
  },
  "files": [
    "dist",
    "tokens",
    "spec",
    "docs",
    "impl",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "sh test/run.sh"
  },
  "repository": "github:JawsomeJason/lcars-design-system"
}
